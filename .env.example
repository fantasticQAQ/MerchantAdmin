# ===================== 环境配置模板 =====================
# 使用方法：复制为 .env 并填写真实值

# SQL Server SA 密码（sqlserver 容器 + 各服务连接字符串共用）
SQLSERVER_SA_PASSWORD=your-strong-sa-password

# JWT（Identity / Merchant 两个服务必须一致，Key 至少 32 字符）
JWT_ISSUER=http://localhost:5001
JWT_KEY=your-jwt-signing-key-at-least-32-chars

# 内部服务通信密钥（Merchant 调 Identity 内部接口用，两端保持一致）
INTERNAL_API_KEY=your-internal-api-key

# 微信小程序（在微信公众平台「开发管理 → 开发设置」获取）
WECHAT_APPID=your-wechat-appid
WECHAT_APPSECRET=your-wechat-appsecret